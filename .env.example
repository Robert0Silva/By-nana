# Copie este arquivo para .env e preencha com valores reais. Nunca commite o .env.

# Postgres (Neon). Use um banco exclusivo de desenvolvimento/QA neste arquivo.
# Nunca reutilize aqui a DATABASE_URL do serviço de produção: testes criam e removem dados.
# No Render, configure a URL de produção diretamente nas variáveis do serviço.
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=verify-full&channel_binding=require

# Segredos usados para assinar os tokens de sessão (HMAC). Gere valores aleatórios únicos,
# por exemplo com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
ADMIN_SESSION_SECRET=

# Usados só uma vez por `node db/seed-admin.js`, para criar o primeiro admin (owner).
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# E-mail transacional (Resend) — deixe em branco para desativar o envio de e-mail (a loja
# continua funcionando normalmente, só não manda confirmação/redefinição de senha por e-mail).
RESEND_API_KEY=
EMAIL_FROM=

# Domínio final do site (com https://, sem barra no final) — usado no sitemap, robots.txt,
# og:image e no link do e-mail de carrinho abandonado.
SITE_URL=

# WhatsApp de atendimento com DDI + DDD, somente números (ex.: 5531999999999).
# Sem configuração, mantém o número atualmente usado pela loja.
WHATSAPP_NUMBER=5531973053380

# Opcionais — em branco vira no-op automático no analytics.js (nenhum script de rastreio carrega).
GA4_MEASUREMENT_ID=
META_PIXEL_ID=

# Opcional — sem isso, o checkout continua 100% manual via WhatsApp (comportamento atual).
# Com PAYMENT_PROVIDER=pagseguro, o site passa a oferecer "Pagar agora (Pix/cartão)" como
# forma de pagamento a mais (as demais continuam manuais/WhatsApp) — ver payment-provider.js.
PAYMENT_PROVIDER=

# Só usados quando PAYMENT_PROVIDER=pagseguro (Checkout PagBank/ex-PagSeguro).
# Token da conta — Portal do Desenvolvedor (https://portaldev.pagbank.com.br/) > Tokens em
# sandbox; Vendas > Integrações > Gerar Token no painel normal em produção. Usado tanto pra
# autenticar as chamadas de API quanto pra validar a assinatura dos webhooks.
PAGSEGURO_TOKEN=
# "true" pra usar o ambiente de testes (sandbox.api.pagseguro.com) em vez de produção.
PAGSEGURO_SANDBOX=

# Porta/host do servidor local (opcionais — os valores abaixo já são o padrão).
PORT=8787
HOST=0.0.0.0
